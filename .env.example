VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_PUBLIC_ANON_KEY

# VITE_SUPABASE_ENV_SCOPE e a UNICA variavel que decide se o ambiente e
# producao. Quando for "production", o app automaticamente: exige login real
# (nao aceita mais o owner anonimo compartilhado), obriga o modo Supabase
# (desabilita o modo Local), e esconde a secao de "dados descartaveis de
# teste" da tela Backup. Nao existe mais uma segunda variavel independente
# para isso (VITE_SUPABASE_HOMOLOGATION_ONLY foi removida: era o que causava
# o risco de o app achar "producao" mas continuar em modo homologacao por
# uma variavel esquecida).

# Homologacao isolada (anonimo controlado)
VITE_SUPABASE_ENV_SCOPE=homolog-default
VITE_SUPABASE_OWNER_ID=anon-homolog

# Producao (autenticacao obrigatoria) - descomente a linha abaixo e comente as de cima
# VITE_SUPABASE_ENV_SCOPE=production
